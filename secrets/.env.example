# Copy to secrets/.env and fill in. secrets/.env is gitignored.
# AWS account credentials stay in the AWS CLI profile, not in this file.
# Device private keys and Wi-Fi passwords may also live in this directory.

# Google OAuth web client ID (….apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# IoT Core data ATS endpoint hostname, without https://
IOT_DATA_ENDPOINT=

# ApiUrl output from the stack. Used by the local web console.
VITE_API_URL=
