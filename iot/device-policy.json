{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": "iot:Connect", "Resource": "arn:aws:iot:REGION:ACCOUNT_ID:client/THING_NAME" },
    { "Effect": "Allow", "Action": "iot:Subscribe", "Resource": [
      "arn:aws:iot:REGION:ACCOUNT_ID:topicfilter/radio/THING_NAME/commands",
      "arn:aws:iot:REGION:ACCOUNT_ID:topicfilter/$aws/things/THING_NAME/shadow/update/delta"
    ] },
    { "Effect": "Allow", "Action": "iot:Receive", "Resource": [
      "arn:aws:iot:REGION:ACCOUNT_ID:topic/radio/THING_NAME/commands",
      "arn:aws:iot:REGION:ACCOUNT_ID:topic/$aws/things/THING_NAME/shadow/update/delta"
    ] },
    { "Effect": "Allow", "Action": "iot:Publish", "Resource": [
      "arn:aws:iot:REGION:ACCOUNT_ID:topic/radio/THING_NAME/telemetry",
      "arn:aws:iot:REGION:ACCOUNT_ID:topic/radio/THING_NAME/responses",
      "arn:aws:iot:REGION:ACCOUNT_ID:topic/$aws/things/THING_NAME/shadow/update"
    ] }
  ]
}
